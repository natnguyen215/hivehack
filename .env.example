# Copy this file to .env and fill in real values before running docker compose.

# Mapbox token — used server-side by the backend proxy endpoints
MAPBOX_TOKEN=your_mapbox_token_here

# PostgreSQL connection string — required by the backend service
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://ember:ember@postgres:5432/emberpath

# Redis connection string — required by the backend service
# Format: redis://<host>:<port>/<db>
REDIS_URL=redis://redis:6379/0

# Secret key used to HMAC-sign cache keys — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Set to false in production to return 503 instead of silently serving mock routes when the routing engine fails
# Recommended production value: false
ALLOW_MOCK_FALLBACK=false
